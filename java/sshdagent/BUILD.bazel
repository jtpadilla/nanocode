load("@rules_java//java:defs.bzl", "java_binary", "java_library", "java_plugin")

package(default_visibility = ["//visibility:public"])

# Procesador de anotaciones de Helidon. Genera en compilación los descriptores
# de servicio (*__ServiceDescriptor) y los metadatos del Service Registry a
# partir de @Service.* El motor es genérico (AptProcessor); las extensiones de
# `helidon-service-codegen` se descubren por ServiceLoader en el processor path.
java_plugin(
    name = "helidon_codegen",
    generates_api = False,
    processor_class = "io.helidon.codegen.apt.AptProcessor",
    deps = [
        "@maven//:io_helidon_codegen_helidon_codegen_apt",
        "@maven//:io_helidon_service_helidon_service_codegen",
    ],
)

java_library(
    name = "sshd",
    srcs = glob(
        ["src/main/java/**/*.java"],
        exclude = ["src/main/java/**/Main.java"],
    ),
    plugins = [":helidon_codegen"],
    resources = ["src/main/resources/hostkey.pem"],
    resource_strip_prefix = "java/sshdagent/src/main/resources",
    deps = [
        "@maven//:io_helidon_common_helidon_common",
        "@maven//:io_helidon_common_helidon_common_types",
        "@maven//:io_helidon_service_helidon_service_registry",
        "@maven//:org_apache_sshd_sshd_common",
        "@maven//:org_apache_sshd_sshd_core",
        "@maven//:org_jline_jline",
        "@maven//:org_slf4j_slf4j_api",
    ],
)

java_binary(
    name = "demo",
    srcs = ["src/main/java/io/github/jtpadilla/sshdagent/Main.java"],
    main_class = "io.github.jtpadilla.sshdagent.Main",
    deps = [
        ":sshd",
        "@maven//:io_helidon_service_helidon_service_registry",
        "@maven//:org_slf4j_slf4j_simple",
    ],
)
